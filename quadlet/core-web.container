# Веб-приложение Core-системы (Django + gunicorn).
# Запускается от пользователя core (без root), управляется systemd через Quadlet.
# Образ собирается локально скриптом bin/build-web.

[Unit]
Description=Core web (Django)
# Без базы приложение бесполезно: запускаться после неё.
Requires=core-postgres.service
After=core-postgres.service

[Container]
ContainerName=core-web
# Локальный образ: current - последняя сборка; рядом лежит тег с коммитом для отката.
Image=localhost/core-web:current
# Образ только локальный, из интернета его не скачивать.
Pull=never

# Сеть core-net: база доступна по имени core-postgres.
Network=core.network
# Порт приложения - только для самого сервера (127.0.0.1). Наружу - позже, через HTTPS.
PublishPort=127.0.0.1:8000:8000

# Секреты - в виде файлов /run/secrets/<имя> внутри контейнера.
Secret=pg_app_password
Secret=django_secret_key
# Данные для входа в ЕРСП (bin/ersp-secret). Токен приложение получает само.
Secret=ersp_prod_credentials
Secret=ersp_sandbox_credentials

# Настройки среды (см. app/config/settings.py).
Environment=DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
Environment=DJANGO_DB_HOST=core-postgres
Environment=DJANGO_DB_NAME=core
Environment=DJANGO_DB_USER=core_app
# ЕРСП: чтение (провайдер, справочники) - боевая среда, отправка - песочница.
Environment=ERSP_READ_ENV=prod
Environment=ERSP_SEND_ENV=sandbox
# Краткий код страховой, которой принадлежат секреты ersp_*_credentials.
Environment=ERSP_CREDENTIALS_COMPANY=mosaic

# Защита: файловая система только для чтения, никаких особых прав Linux,
# процессы не могут повысить себе права.
ReadOnly=true
DropCapability=ALL
NoNewPrivileges=true

# Не больше 1 ГБ ОЗУ.
Memory=1g

# Проверка живости: отвечает ли приложение на /healthz/.
HealthCmd=python /app/healthcheck.py
HealthInterval=30s
HealthStartPeriod=20s

[Service]
Restart=always
TimeoutStartSec=120

[Install]
WantedBy=default.target
