# Том с файлами Core-системы (сканы соглашений, позже - договоры, убытки).
# Живёт отдельно от контейнера: пересборка и перезапуск core-web файлы не трогают.
# Модель - docs/files-model.md.

[Unit]
Description=Том файлов (Core)

[Volume]
# Явное имя тома. Без него Quadlet добавил бы приставку "systemd-".
VolumeName=core-files
# Владелец папки тома - пользователь приложения внутри контейнера core-web
# (app, UID и GID 10001 - см. app/Containerfile): писать в том может только
# приложение. Для остальных папка закрыта.
User=10001
Group=10001
