# Общая сеть контейнеров Core-системы.
# Внутри сети контейнеры находят друг друга по имени (встроенный DNS Podman):
# например, Django подключается к базе по адресу core-postgres:5432.
# Подсеть задана явно, чтобы адреса не менялись и не пересекались с офисной 192.168.112.0/24.

[Network]
NetworkName=core-net
Subnet=10.89.10.0/24
Gateway=10.89.10.1
