#!/usr/bin/env bash
# build-web - собрать образ веб-приложения из ЗАКОММИЧЕННОГО кода папки app/.
# Запуск из ~/core-platform под support: bin/build-web
#
# Результат: образ localhost/core-web с двумя тегами:
#   :<коммит>  - например :1a55902, для отката на любую прошлую версию;
#   :current   - его использует quadlet/core-web.container.
# Сборка идёт от имени core: образ попадает в его хранилище Podman.

set -euo pipefail
cd "$(dirname "$0")/.."

# 1. Собираем только то, что в git: незакоммиченные правки в app/ не допускаются.
if [ -n "$(git status --porcelain -- app)" ]; then
  echo "ОШИБКА: в app/ есть незакоммиченные изменения:" >&2
  git status --short -- app >&2
  exit 1
fi

REV="$(git rev-parse --short HEAD)"
IMAGE="localhost/core-web"
CONTEXT="/home/core/build/core-web"     # папка сборки у core: support её не читает напрямую

echo "Сборка $IMAGE:$REV из коммита $REV"

# 2. Выгружаем app/ из коммита и распаковываем в папку сборки core (старую стираем).
git archive --format=tar "HEAD:app" | bin/core-run bash -c \
  "rm -rf '$CONTEXT' && mkdir -p '$CONTEXT' && tar -x -C '$CONTEXT'"

# 3. Собираем образ, помечая его номером коммита.
bin/core-run podman build \
  --tag "$IMAGE:$REV" \
  --tag "$IMAGE:current" \
  --label "org.opencontainers.image.revision=$REV" \
  --file "$CONTEXT/Containerfile" \
  "$CONTEXT"

echo "OK: $IMAGE:$REV (он же :current)"
