#!/usr/bin/env bash
# ersp-secret - завести секрет Podman с данными для входа в ЕРСП.
# Запуск из ~/core-platform под support:
#   bin/ersp-secret prod              боевая среда  -> секрет ersp_prod_credentials
#   bin/ersp-secret sandbox           песочница     -> секрет ersp_sandbox_credentials
#   bin/ersp-secret prod --replace    заменить уже заведённый секрет (сменился пароль)
#
# Зачем так, а не готовым токеном. Токен ЕРСП временный (метод /oauth/v2/token
# выдаёт его на срок expires_in). Готовый токен однажды истечёт, и обмен
# с ЕРСП встанет. Поэтому в секрете лежат данные для входа, а приложение
# само получает токен и держит его только в памяти - ни в базе, ни в журналах
# его нет (решение Бекзода 20.10).
#
# Что внутри секрета - JSON из четырёх значений, выданных НАПП:
#   {"client_id": ..., "client_secret": ..., "username": ..., "password": ...}
#
# Безопасность ввода:
# - значения вводятся в ответ на вопросы скрипта, а не в командной строке,
#   поэтому не попадают в историю команд (.bash_history) и в список процессов;
# - client_secret и пароль при вводе не отображаются на экране;
# - JSON собирается и передаётся в podman через канал (|), без временных файлов.

set -euo pipefail
cd "$(dirname "$0")/.."

ENV_NAME="${1:-}"
REPLACE="${2:-}"

case "$ENV_NAME" in
  prod|sandbox) ;;
  *)
    echo "Использование: bin/ersp-secret prod|sandbox [--replace]" >&2
    exit 1
    ;;
esac
if [ -n "$REPLACE" ] && [ "$REPLACE" != "--replace" ]; then
  echo "Непонятный параметр: $REPLACE (можно только --replace)" >&2
  exit 1
fi

SECRET="ersp_${ENV_NAME}_credentials"

# Секрет уже есть - без --replace не трогаем: случайный повторный запуск
# не должен затереть рабочие данные для входа.
if bin/core-run podman secret inspect "$SECRET" >/dev/null 2>&1; then
  if [ "$REPLACE" != "--replace" ]; then
    echo "Секрет $SECRET уже есть. Чтобы заменить: bin/ersp-secret $ENV_NAME --replace" >&2
    exit 1
  fi
  REPLACE_FLAG="--replace"
else
  REPLACE_FLAG=""
fi

echo "Данные для входа в ЕРСП, среда: $ENV_NAME (секрет $SECRET)"
read -rp  "client_id: " CLIENT_ID
read -rsp "client_secret (не отображается): " CLIENT_SECRET; echo
read -rp  "логин (username): " USERNAME_ERSP
read -rsp "пароль (не отображается): " PASSWORD_ERSP; echo

for value in "$CLIENT_ID" "$CLIENT_SECRET" "$USERNAME_ERSP" "$PASSWORD_ERSP"; do
  if [ -z "$value" ]; then
    echo "ОШИБКА: все четыре значения обязательны. Секрет не создан." >&2
    exit 1
  fi
done

# printf - встроенная команда bash: значения не видны в списке процессов.
# python3 собирает правильный JSON (кавычки и \ в пароле не сломают его).
printf '%s\n' "$CLIENT_ID" "$CLIENT_SECRET" "$USERNAME_ERSP" "$PASSWORD_ERSP" \
  | python3 -c '
import json, sys
keys = ["client_id", "client_secret", "username", "password"]
values = sys.stdin.read().split("\n")[:4]
sys.stdout.write(json.dumps(dict(zip(keys, values)), ensure_ascii=False))
' \
  | bin/core-run podman secret create $REPLACE_FLAG "$SECRET" - >/dev/null

unset CLIENT_ID CLIENT_SECRET USERNAME_ERSP PASSWORD_ERSP
echo "Готово: секрет $SECRET заведён. Значения на экран не выводятся."
echo "Проверка входа в ЕРСП - после выкладки модуля интеграции."
